        ".zigversion",
        ".zig-audit.json",
        "LICENSE",
        "build.zig",
        "build.zig.zon",
        "assets",
        "protocols",
        "src",
        "tools",
        "vendor/howl-text",
        "vendor/sdl",
        "vendor/stb",
    },
}
